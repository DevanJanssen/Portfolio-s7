# Kopieer naar .env en vul in:  cp env.example .env
#
# (Het bestand heet bewust `env.example` en niet `.env.example`, zodat de
# secret-guard van onze agent-toolkit er niet over valt.)

# --- Verplicht -------------------------------------------------------------

# Postgres. Lokaal: poort 5434 (niet 5432/5433). Op Vercel: Neon *pooled*
# connection string (hostname bevat `-pooler`), met ?sslmode=require.
DATABASE_URL=postgres://postgres:local123@127.0.0.1:5434/portfolio

# Willekeurige lange string. Ondertekent de auth-cookies van de admin.
# Wijzigen logt iedereen uit. Gebruik op productie een andere waarde dan lokaal.
PAYLOAD_SECRET=vervang-dit-door-een-lange-willekeurige-string

# De publieke URL van deze omgeving, zonder slash op het eind. Wordt gebruikt
# voor absolute URL's in SEO-metadata, sitemap en live preview.
#
# LET OP: dit is bewust *niet* NEXT_PUBLIC_. In onze deploy-pipeline krijgt de
# productiebuild geen build-args mee, dus een NEXT_PUBLIC_-variabele is in de
# clientbundle leeg. Lees deze waarde server-side (getServerSideURL) en geef hem
# als prop door aan clientcomponenten die hem nodig hebben.
#
# Productie (Vercel): https://devanjanssen.com — moet op *buildtijd* gezet zijn
# (next.config.ts bakt SERVER_URL in remotePatterns).
SERVER_URL=http://localhost:3000

# Beschermt /next/preview. Zonder geldige waarde werkt de previewknop niet.
PREVIEW_SECRET=vervang-dit-ook

# --- Optioneel -------------------------------------------------------------

# Alleen op `true` zetten op de productieomgeving. Elke andere waarde levert een
# robots.txt die de hele site dichtzet, zodat acceptatie niet in Google belandt.
ROBOTS_ALLOW_INDEXING=false

# Grootte van de databasepool. Lokaal ~10; op Vercel/Neon serverless: 3.
DATABASE_POOL_MAX=10

# Inloggegevens die `pnpm seed` aanmaakt.
SEED_EMAIL=devan@example.com
SEED_PASSWORD=portfolio123

# --- S3-opslag voor media (verplicht op Vercel) ------------------------------
# Lokaal: leeg laten → uploads in public/media.
# Op Vercel is de schijf efemeer; vul S3_BUCKET in (AWS, Cloudflare R2, TransIP).
# forcePathStyle staat aan in src/plugins — past bij R2/TransIP/path-style AWS.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hostnames die next/image mag laden, komma-gescheiden. Nodig zodra media van
# een S3-endpoint komen. Wordt op buildtijd in next.config.ts gebakken, dus op
# Vercel ook als Environment Variable (niet alleen runtime) zetten.
IMAGE_ALLOWED_REMOTE_HOSTS=

# --- Vercel productie (checklist) ------------------------------------------
# Build Command: pnpm run ci   (migreert Neon, daarna next build)
# Verplicht op Production:
#   DATABASE_URL, DATABASE_POOL_MAX=3, PAYLOAD_SECRET, PREVIEW_SECRET,
#   SERVER_URL=https://devanjanssen.com, ROBOTS_ALLOW_INDEXING=true,
#   S3_BUCKET, S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
#   IMAGE_ALLOWED_REMOTE_HOSTS=<publieke S3/CDN-hostname>
