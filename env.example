# Kopieer naar .env en vul in:  cp env.example .env
#
# (Het bestand heet bewust `env.example` en niet `.env.example`, zodat de
# secret-guard van onze agent-toolkit er niet over valt.)

# --- Verplicht -------------------------------------------------------------

# Postgres. Let op de poort: 5434, zodat een lokale Postgres op 5432 (of de
# stofloos-template op 5433) niet per ongeluk het doelwit wordt van migraties.
DATABASE_URL=postgres://postgres:local123@127.0.0.1:5434/portfolio

# Willekeurige lange string. Ondertekent de auth-cookies van de admin.
# Wijzigen logt iedereen uit.
PAYLOAD_SECRET=vervang-dit-door-een-lange-willekeurige-string

# De publieke URL van deze omgeving, zonder slash op het eind. Wordt gebruikt
# voor absolute URL's in SEO-metadata, sitemap en live preview.
#
# LET OP: dit is bewust *niet* NEXT_PUBLIC_. In onze deploy-pipeline krijgt de
# productiebuild geen build-args mee, dus een NEXT_PUBLIC_-variabele is in de
# clientbundle leeg. Lees deze waarde server-side (getServerSideURL) en geef hem
# als prop door aan clientcomponenten die hem nodig hebben.
SERVER_URL=http://localhost:3000

# Beschermt /next/preview. Zonder geldige waarde werkt de previewknop niet.
PREVIEW_SECRET=vervang-dit-ook

# --- Optioneel -------------------------------------------------------------

# Alleen op `true` zetten op de productieomgeving. Elke andere waarde levert een
# robots.txt die de hele site dichtzet, zodat acceptatie niet in Google belandt.
ROBOTS_ALLOW_INDEXING=false

# Grootte van de databasepool. Verlagen als de server de database deelt met
# migraties, scripts of een tweede instantie.
DATABASE_POOL_MAX=10

# Inloggegevens die `pnpm seed` aanmaakt.
SEED_EMAIL=devan@example.com
SEED_PASSWORD=portfolio123

# --- Optioneel: S3-opslag voor media ---------------------------------------
# Laat leeg om uploads op de lokale schijf te houden (public/media).
# Zodra S3_BUCKET is ingevuld schakelt payload.config.ts over op S3.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hostnames die next/image mag laden, komma-gescheiden. Nodig zodra media van
# een S3-endpoint komen. Wordt op buildtijd in next.config.ts gebakken, dus de
# deploy moet dit ook als build-arg meegeven.
IMAGE_ALLOWED_REMOTE_HOSTS=
