---
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import { getProjects, href, subtitle } from '../../lib/projects'

const projects = await getProjects()
---

<Base title="Projects">
  <h1 class="visually-hidden">Projects</h1>
  <ul class="list">
    {projects.map((p, i) => (
      <li>
        <a class="item" href={href(p)} data-index={i}>
          <span class="t">{p.data.title}</span>
          <span class="s mono">{subtitle(p)}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="preview" slot="after" aria-hidden="true">
    {projects.map((p, i) => (
      <div
        class:list={['frame-img', p.data.coverFit]}
        data-index={i}
        style={p.data.coverBackground ? `background:${p.data.coverBackground}` : undefined}
      >
        {p.data.previewVideo ? (
          <video src={p.data.previewVideo} muted loop playsinline preload="none" />
        ) : (
          <Image src={p.data.cover} alt="" widths={[480, 960]} sizes="460px" loading="eager" />
        )}
      </div>
    ))}
  </div>
</Base>

<style>
  .list {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: clamp(18px, 2.4vw, 28px);
  }
  .item {
    display: block;
  }
  .t {
    display: block;
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    transition:
      color 0.25s,
      opacity 0.25s,
      transform 0.35s var(--ease);
  }
  .s {
    display: block;
    margin-top: 6px;
    transition: color 0.25s;
  }
  .item:hover .t,
  .item:focus-visible .t {
    color: var(--hover);
    transform: translateX(-8px);
  }
  .item:hover .s,
  .item:focus-visible .s {
    color: var(--text);
  }
  .list:has(.item:hover) .item:not(:hover) .t {
    opacity: 0.45;
  }

  /* centred preview, sits behind the list (z-index below .layout) */
  .preview {
    position: fixed;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: min(34vw, 460px);
    aspect-ratio: 4 / 3;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .frame-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 0.3s,
      transform 0.5s var(--ease);
  }
  .frame-img.on {
    opacity: 1;
    transform: none;
  }
  .frame-img :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame-img.contain :is(img, video) {
    object-fit: contain;
    padding: 12%;
  }

  @media (max-width: 760px), (hover: none) {
    .preview {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .list {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

<script>
  const frames = [...document.querySelectorAll<HTMLElement>('.frame-img')]
  const show = (index: string | undefined) => {
    for (const f of frames) {
      const on = f.dataset.index === index
      f.classList.toggle('on', on)
      const video = f.querySelector('video')
      if (video) on ? video.play().catch(() => {}) : video.pause()
    }
  }
  for (const item of document.querySelectorAll<HTMLElement>('.item')) {
    item.addEventListener('mouseenter', () => show(item.dataset.index))
    item.addEventListener('mouseleave', () => show(undefined))
    item.addEventListener('focus', () => show(item.dataset.index))
    item.addEventListener('blur', () => show(undefined))
  }
</script>
