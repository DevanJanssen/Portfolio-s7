---
/** Heading on the left (sticky), free text on the right. */
interface Props {
  title: string
}
const { title } = Astro.props
---

<section class="section">
  <h2>{title}</h2>
  <div class="text">
    <slot />
  </div>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(16px, 2vw, 28px);
  }
  h2 {
    grid-column: 1 / 5;
    align-self: start;
    position: sticky;
    top: var(--edge);
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .text {
    grid-column: 6 / 13;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .text :global(p),
  .text :global(li) {
    font-size: 17px;
    line-height: 1.65;
    max-width: 62ch;
  }
  .text :global(ul),
  .text :global(ol) {
    padding-left: 1.2em;
  }
  .text :global(strong) {
    font-weight: 600;
  }
  .text :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .text :global(a:hover) {
    color: var(--hover);
  }
  @media (max-width: 760px) {
    h2,
    .text {
      grid-column: 1 / -1;
    }
    h2 {
      position: static;
      margin-bottom: 16px;
    }
  }
</style>
