---
/** One big statement, e.g. the problem in a single line. */
---

<div class="callout">
  <slot />
</div>

<style>
  .callout,
  .callout :global(p) {
    font-size: clamp(28px, 4.2vw, 60px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 22ch;
  }
</style>
