---
import Figure from './Figure.astro'
import type { ImageMetadata } from 'astro'

/** Old vs new side by side, with a short explanation underneath. */
interface Props {
  before?: ImageMetadata
  after?: ImageMetadata
  beforeAlt: string
  afterAlt: string
  ratio?: string
}
const { before, after, beforeAlt, afterAlt, ratio = '3 / 4' } = Astro.props
---

<div class="ba">
  <div class="pair">
    <Figure src={before} alt={beforeAlt} caption="Before" ratio={ratio} />
    <Figure src={after} alt={afterAlt} caption="After" ratio={ratio} />
  </div>
  <div class="text">
    <slot />
  </div>
</div>

<style>
  .ba {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.4vw, 18px);
  }
  .text :global(p) {
    font-size: 17px;
    line-height: 1.6;
    max-width: 62ch;
  }
  .text :global(strong) {
    font-weight: 600;
  }
</style>
