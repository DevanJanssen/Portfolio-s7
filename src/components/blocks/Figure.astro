---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/**
 * An image or video with a caption. Without `src`/`video` it renders a placeholder
 * box showing the alt text, so you can plan the page before you have the visuals.
 */
interface Props {
  src?: ImageMetadata
  video?: string
  alt: string
  caption?: string
  ratio?: string
  fit?: 'cover' | 'contain'
  background?: string
}
const { src, video, alt, caption, ratio, fit = 'cover', background } = Astro.props
const aspect = ratio ?? (src ? `${src.width} / ${src.height}` : '16 / 9')
---

<figure class="figure">
  <div
    class:list={['media', fit, { empty: !src && !video }]}
    style={`aspect-ratio:${aspect};${background ? `background:${background}` : ''}`}
  >
    {video ? (
      <video src={video} autoplay muted loop playsinline aria-label={alt} />
    ) : src ? (
      <Image
        src={src}
        alt={alt}
        widths={[800, 1400, 2000]}
        sizes="(max-width: 760px) 100vw, 92vw"
      />
    ) : (
      <span class="mono">{alt}</span>
    )}
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .media {
    overflow: hidden;
  }
  .media :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media.contain :is(img, video) {
    object-fit: contain;
  }
  .empty {
    display: grid;
    place-items: center;
    padding: 16px;
    text-align: center;
    background: rgba(255, 95, 168, 0.06);
  }
  figcaption {
    max-width: 70ch;
    line-height: 1.5;
  }
</style>
